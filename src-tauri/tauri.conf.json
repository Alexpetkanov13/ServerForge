{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerForge",
  "version": "0.2.0",
  "identifier": "com.dheaven.serverforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNDVFMUIwQkQwRUIxM0QKUldROXNRNjlzT0ZGYncrQ3VPNDduS2xxeDZPM0h2SHBqcTEwclE4MTArU0V5bXB1cFBOMElqVEIK",
      "endpoints": [
        "https://github.com/Alexpetkanov13/ServerForge/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ServerForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "DHeaven",
    "copyright": "Copyright © 2026 DHeaven",
    "category": "Utility",
    "shortDescription": "Create and manage Minecraft Java servers",
    "longDescription": "ServerForge is a premium desktop control panel for creating, installing, configuring, and running Minecraft Java Edition servers locally.",
    "licenseFile": "windows/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "compression": "lzma",
        "startMenuFolder": "ServerForge",
        "displayLanguageSelector": false,
        "installerIcon": "windows/branding/installer.ico",
        "uninstallerIcon": "windows/branding/installer.ico",
        "headerImage": "windows/branding/header.bmp",
        "sidebarImage": "windows/branding/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": {
          "English": "windows/english.nsh"
        }
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
